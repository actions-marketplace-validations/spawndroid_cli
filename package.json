{
  "name": "spawndroid",
  "version": "0.1.6",
  "description": "Run Android tests on hosted devices from any CI.",
  "type": "module",
  "bin": {
    "spawndroid": "src/spawndroid.mjs"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/spawndroid.test.mjs test/config.test.mjs test/run.test.mjs test/check.test.mjs test/api.test.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spawndroid/cli.git"
  },
  "homepage": "https://spawndroid.io",
  "bugs": {
    "url": "https://github.com/spawndroid/cli/issues"
  },
  "keywords": [
    "android",
    "appium",
    "webdriver",
    "emulator",
    "testing",
    "ci"
  ],
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
